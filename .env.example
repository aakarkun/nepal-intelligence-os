# Nepal Intelligence OS — Environment Variables

# API
API_PORT=3001
API_URL=http://localhost:3001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

# LiveKit (War Room)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
NEXT_PUBLIC_ENABLE_WAR_ROOM=false

# Database (Phase 2 — not required for initial launch)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nepal_intel

# Redis (optional — for SSE fan-out scaling)
REDIS_URL=redis://localhost:6379

# Worker
REPLAY_SPEED=5

# Worker — Live mode (real ECN + news feeds)
# Set MODE=live when you want to ingest real data instead of replaying fixtures.
MODE=live

# How often to poll ECN + news feeds (in minutes).
# If set to 0, the worker will run once and exit.
CRON_ECN_MINUTES=5

# ECN base URL for scraping live election data (override if ECN changes domains/paths).
ECN_BASE_URL=https://election.gov.np/results

# Optional override/extension to committed config:
# Semicolon-separated list of RSS/Atom news feeds.
# Format: Name|URL;Name2|URL2;...
# NEWS_FEEDS=Some Extra Feed|https://example.com/rss

# Set to true to log feed item timestamps (for debugging).
DEBUG_NEWS_TIMES=false

# X (Twitter) — optional (official API)
# TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# X (Twitter) without API key — Nitter RSS (optional; add "nitter" in social-feeds.json)
# NITTER_BASE_URL=https://nitter.poast.org

# Reddit — optional; use to reduce IP block risk
# REDDIT_USER_AGENT=nepal-intelligence-os/1.0 (reddit ingestion)
# REDDIT_DELAY_MS=5000
# REDDIT_MAX_RETRIES=2
# REDDIT_PROXY=http://proxy:8080
# Note: GDELT Reddit (fetchGdeltRedditEvents) runs automatically and does not hit Reddit.
