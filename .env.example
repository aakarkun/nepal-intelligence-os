# Nepal Intelligence OS — Environment Variables
# Single reference for the whole repo. Use one root .env for local dev and Docker;
# per-app .env.example files list only what each app needs (API / Worker / Web).

# =============================================================================
# API (apps/api) — only the API reads DATABASE_URL; Worker and Web do not.
# =============================================================================
API_PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nepal_intel

# Optional: protect GET/PATCH /v1/worker-state (same value as worker's WORKER_SECRET)
# WORKER_SECRET=

# Optional: admin circuit breaker reset (POST /admin/sources/:id/reset)
# ADMIN_SECRET=

# Optional: Intel briefing (POST /v1/intel/brief). If unset, returns 503.
# ANTHROPIC_API_KEY=

# Political Pulse — Claude classification for RSS (worker) and weekly digest
# CLAUDE_MODEL=claude-sonnet-4-20250514

# =============================================================================
# Worker (apps/worker) — talks to API only; no DB connection.
# =============================================================================
API_URL=http://localhost:3001

# Optional: same as API WORKER_SECRET for /v1/worker-state auth
# WORKER_SECRET=

# Optional: for admin actions (e.g. circuit breaker); same as API ADMIN_SECRET
# ADMIN_SECRET=

MODE=live

# Political Pulse workers (RSS poll interval minutes; parliament scrape hours)
# RSS_POLL_INTERVAL_MINUTES=30
# PARLIAMENT_SCRAPE_INTERVAL_HOURS=4
# TZ=Asia/Kathmandu
# Election scrape: off by default (election finalized). Set to "true" only when you need to re-scrape.
# SCRAPE_ELECTION=false
CRON_ECN_MINUTES=30
ECN_BASE_URL=https://election.ekantipur.com/?lng=eng
ENABLE_SCRAPLING_ECN=true
ENABLE_GDELT=false
ENABLE_REDDIT=false
SCRAPLING_REQUEST_DELAY_MS=1000
LIVE_STATE_PATH=.live-worker-state.json
MARKET_ASSET_MINUTES=360

# Optional: override/extension for RSS/Atom feeds (semicolon-separated: Name|URL;...)
# NEWS_FEEDS=

DEBUG_NEWS_TIMES=false

# Optional: Reddit pacing (worker only)
# REDDIT_USER_AGENT=nepal-intelligence-os/1.0
# REDDIT_DELAY_MS=5000
# REDDIT_MAX_RETRIES=2
# REDDIT_PROXY=

# Optional: Nitter base URL for X/Twitter RSS (worker only)
# NITTER_BASE_URL=https://nitter.poast.org

# Optional: watchlist alerts to Telegram (worker only)
# TELEGRAM_BOT_TOKEN=

# Optional: Upcoming Issues — ShareSansar page URL (worker scrapes this; same pipeline as NEPSE HTML).
# Canonical URL (board-approved): clean path; mirrors index.php/upcoming-issue content.
# Option A: set this in repo-root `.env` (docker-compose passes it to the worker).
UPCOMING_ISSUES_SOURCE_URL=https://www.sharesansar.com/upcoming-issue

# Optional: throttle upcoming issues scrape (minutes). Default: 720 (12h).
UPCOMING_ISSUES_MINUTES=720

# Optional: DHM scrape (worker only)
# ENABLE_DHM_SCRAPE=false

# Replay (worker only)
# REPLAY_SPEED=5

# =============================================================================
# Web (apps/web) — only NEXT_PUBLIC_* are available in the browser.
# =============================================================================
# Docker Compose only: published host port for the `web` service (container still listens on 3000 inside).
# Use 3100 if host :3000 is busy or to line up with `tailscale serve --bg 3100`.
# WEB_HOST_PORT=3000
# Leave empty to use same-origin Next.js proxy (/v1 and /api/stream rewrites).
NEXT_PUBLIC_API_URL=
# Backend target for Next.js proxy rewrites in apps/web.
API_PROXY_TARGET=http://localhost:3001
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here
NEXT_PUBLIC_ENABLE_WAR_ROOM=false
NEXT_PUBLIC_CRON_ECN_MINUTES=30
NEXT_PUBLIC_SSE_STALE_SECONDS=90

# Optional: LiveKit for War Room (future token API; not yet used in code)
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
