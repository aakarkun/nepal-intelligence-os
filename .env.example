# Nepal Intelligence OS — Environment Variables

# API
API_PORT=3001
API_URL=http://localhost:3001
API_STATE_PATH=apps/api/.live-api-state.json
API_BOOTSTRAP_STATE_PATH=data/bootstrap/live-api-state.json

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

# LiveKit (War Room)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
NEXT_PUBLIC_ENABLE_WAR_ROOM=false

# Database (Phase 2 — not required for initial launch)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nepal_intel

# Redis (optional — for SSE fan-out scaling)
REDIS_URL=redis://localhost:6379

# Worker
REPLAY_SPEED=5

# Worker — Live mode (real ECN + news feeds)
# Set MODE=live when you want to ingest real data instead of replaying fixtures.
MODE=live

# Optional live enrichers. Disabled by default to avoid rate limits / IP blocks.
ENABLE_GDELT=false
ENABLE_REDDIT=false
ENABLE_SCRAPLING_ECN=true

# How often to poll ECN + news feeds (in minutes).
# If set to 0, the worker will run once and exit.
CRON_ECN_MINUTES=30

# Frontend hint for live election cadence (mirrors CRON_ECN_MINUTES).
# Used to show "next scheduled update" in the UI.
NEXT_PUBLIC_CRON_ECN_MINUTES=30

# Election source URL for Scrapling-backed crawl.
ECN_BASE_URL=https://election.ekantipur.com/?lng=eng

# Persist the last completed live worker cycle so restarts do not immediately scrape again.
LIVE_STATE_PATH=.live-worker-state.json

# Delay between constituency page requests in the Scrapling crawler.
# 1000ms across 165 constituencies means a full pass can take a few minutes, by design.
SCRAPLING_REQUEST_DELAY_MS=1000

# Gold/silver (Gold API) and crypto (CoinGecko, free tier ~60s) refresh in minutes.
# For live-feeling crypto set to 1–2; metals can stay slower.
MARKET_ASSET_MINUTES=360

# Optional override/extension to committed config:
# Semicolon-separated list of RSS/Atom news feeds.
# Format: Name|URL;Name2|URL2;...
# NEWS_FEEDS=Some Extra Feed|https://example.com/rss

# Set to true to log feed item timestamps (for debugging).
DEBUG_NEWS_TIMES=false

# X (Twitter) — optional (official API)
# TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# X (Twitter) without API key — Nitter RSS (optional; add "nitter" in social-feeds.json)
# NITTER_BASE_URL=https://nitter.poast.org

# Flood — DHM station-level data requires data access approval (e.g. info@dhm.gov.np for journalism/research).
# When false (default), worker uses GDACS regional flood events only; set true after DHM whitelist.
ENABLE_DHM_SCRAPE=false

# Intel briefing — Anthropic Messages API for AI-generated briefings from live data.
# If unset, POST /v1/intel/brief returns 503.
# ANTHROPIC_API_KEY=your_anthropic_api_key

# Watchlist alerts — optional; worker sends Telegram messages when watchlist rules match.
# Create a bot via @BotFather and set chat_id on each watchlist item (or use same for all).
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Admin — circuit breaker reset (worker consumes via X-Admin-Secret; API validates on POST /admin/sources/:id/reset).
# Required in both API and worker env when running as separate processes/containers.
# ADMIN_SECRET=your_admin_secret_here

# Reddit — optional; use to reduce IP block risk
# REDDIT_USER_AGENT=nepal-intelligence-os/1.0 (reddit ingestion)
# REDDIT_DELAY_MS=5000
# REDDIT_MAX_RETRIES=2
# REDDIT_PROXY=http://proxy:8080

# Scrapling app (optional Python layer for ECN/news scraping)
# SCRAPLING_TIMEOUT_MS=30000
