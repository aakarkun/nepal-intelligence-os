# API only — copy to .env.
# Local dev: use localhost (below). When Docker db is running, this reaches the same Postgres.
# Docker api container gets DATABASE_URL from docker-compose.yml (host "db"), not from this file.

API_PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nepal_intel

# Optional: protect /v1/worker-state (same as worker WORKER_SECRET)
# WORKER_SECRET=

# Optional: admin circuit breaker reset
# ADMIN_SECRET=

# Optional: Intel briefing (POST /v1/intel/brief)
# ANTHROPIC_API_KEY=
