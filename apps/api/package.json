{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "docker:up": "docker compose -f ../../docker-compose.yml up --build",
    "docker:up:d": "docker compose -f ../../docker-compose.yml up -d --build",
    "api": "bun --watch src/index.ts",
    "dev": "bun --watch src/index.ts",
    "dev:mobile": "API_PORT=3001 bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "echo 'No build step — Bun runs TS directly'",
    "test": "bun test",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate"
  },
  "dependencies": {
    "@repo/shared": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.6",
    "postgres": "^3.4.8",
    "zod": "^3.23"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.9",
    "typescript": "^5.5"
  }
}
