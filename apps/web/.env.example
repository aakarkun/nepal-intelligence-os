# Web only — only NEXT_PUBLIC_* are available in the browser. No DATABASE_URL.

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here
NEXT_PUBLIC_ENABLE_WAR_ROOM=false
NEXT_PUBLIC_CRON_ECN_MINUTES=30
NEXT_PUBLIC_SSE_STALE_SECONDS=90
# Set true to show sample World desk rows without worker/GDELT (local UI only).
# NEXT_PUBLIC_WORLD_ARTICLE_FIXTURE=true
